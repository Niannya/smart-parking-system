<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.backend.auth.UserAccountMapper">
    <resultMap id="accountView" type="org.example.backend.auth.AccountView">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="username" javaType="java.lang.String"/>
            <arg column="display_name" javaType="java.lang.String"/>
            <arg column="role" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <resultMap id="credentials" type="org.example.backend.auth.UserAccountMapper$Credentials">
        <constructor>
            <idArg column="id" javaType="java.lang.Long"/>
            <arg column="username" javaType="java.lang.String"/>
            <arg column="display_name" javaType="java.lang.String"/>
            <arg column="role" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="password_hash" javaType="java.lang.String"/>
            <arg column="updated_at" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <resultMap id="sessionState" type="org.example.backend.auth.UserAccountMapper$SessionState">
        <constructor>
            <arg column="role" javaType="java.lang.String"/>
            <arg column="status" javaType="java.lang.String"/>
            <arg column="updated_at" javaType="java.time.OffsetDateTime"/>
        </constructor>
    </resultMap>

    <sql id="viewColumns">id, username, display_name, role, status</sql>

    <select id="findCredentials" resultMap="credentials">
        SELECT <include refid="viewColumns"/>, password_hash, updated_at
        FROM user_account
        WHERE username = #{username}
    </select>

    <select id="findSessionState" resultMap="sessionState">
        SELECT role, status, updated_at
        FROM user_account
        WHERE id = #{id}
    </select>

    <select id="findViewById" resultMap="accountView">
        SELECT <include refid="viewColumns"/>
        FROM user_account
        WHERE id = #{id}
    </select>

    <select id="findViewByUsername" resultMap="accountView">
        SELECT <include refid="viewColumns"/>
        FROM user_account
        WHERE username = #{username}
    </select>

    <select id="list" resultMap="accountView">
        SELECT <include refid="viewColumns"/>
        FROM user_account
        <where>
            <if test="role != null">AND role = #{role}</if>
            <if test="status != null">AND status = #{status}</if>
        </where>
        ORDER BY id
    </select>

    <insert id="insertOwner">
        INSERT INTO user_account (username, password_hash, display_name, role, status)
        VALUES (#{username}, #{passwordHash}, #{displayName}, 'OWNER', 'ACTIVE')
        ON CONFLICT ON CONSTRAINT uk_user_account_username DO NOTHING
    </insert>

    <update id="updateStatus">
        UPDATE user_account
        SET status = #{status},
            updated_at = CASE
                WHEN status = #{status} THEN updated_at
                ELSE GREATEST(clock_timestamp(), updated_at + INTERVAL '1 microsecond')
            END
        WHERE id = #{id}
    </update>
</mapper>
