<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.backend.mapper.AdminMapper">

    <select id="findAll"
            resultType="org.example.backend.entity.Admin">
        select id, name, dept_name, salary
        from admin
        order by id
    </select>

</mapper>